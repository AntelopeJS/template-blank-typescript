{
  "name": "antelopejs-module",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w",
    "test": "ajs module test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "sync": "antelopejs-sync --profile template",
    "sync:check": "antelopejs-sync --profile template --check",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.0.6 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.17.1",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.0",
    "knip": "^6.43.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "test": "antelope.test.ts"
  }
}
